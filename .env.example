# Same keys locally and in production. Defaults below are for make dev / make web.
# In production, set them on the host (Railway, VPS, AWS). Do not commit .env.

# API — leave empty in production to use the platform PORT
PORT=8080

# Database (matches docker-compose defaults). Production URLs typically use
# postgresql:// and sslmode=require; both schemes are accepted.
DATABASE_URL=postgres://user:password@localhost:5435/autocompare_db?sslmode=disable

# Worker ingest — path to JSON/CSV listings file
INGEST_FILE=testdata/listings.json

# Frontend rewrite target. Local: API on :8080. Production: set at Next.js *build*
# time to the reachable API URL (public or private network).
NEXT_PUBLIC_API_URL=http://localhost:8080
